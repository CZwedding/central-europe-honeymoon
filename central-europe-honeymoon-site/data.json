  "alternatives": {
    "1": [
      "航班延誤時，Dresden 交通需改 Plan B，前往市區方式依抵達狀況。",
      "Dresden 下半天改旅館休息，視體力調整。"
    ],
    "2": [
      "雨雪：改室內博物館、咖啡館並縮短戶外市集時間。"
    ],
    "3": [
      "大雪：先確認 Dresden → Prague 鐵路班次，取消部分布拉格晚間行程。"
    ],
    "4": [
      "夜晚大雪：縮短 CK 坡道及景觀點路線。"
    ],
    "5": [
      "大雨／雪：改城堡外觀、老城室內小店、咖啡館。"
    ],
    "6": [
      "Hellbrunn 停開時：改老城與室內行程，注意市集開放時段。"
    ],
    "7": [
      "雨／小雪：改老城、咖啡館或博物館。",
      "大雪／濕冷：Residenz／Mozart Museum；晚餐需確認是否營業。"
    ],
    "8": [
      "交通正常＋小雪：照原定計畫，注意步行安全。",
      "下雪／停船／延誤：保留等待時間，確認最新渡船班次。",
      "鐵路／渡船重大中斷：先核對官方現況再調整住宿與交通。"
    ],
    "9": [
      "天氣惡劣／交通延誤：減少 Hallstatt 湖畔停留，保留 Vienna 市集。",
      "Hallstatt 渡船停航：先核對替代交通，勿假設能準時趕上火車。",
      "列車延誤：抵達 Vienna 後以 Rathausplatz 為重點。"
    ],
    "10": [
      "天氣穩定：Schönbrunn＋Budapest 市中心。",
      "大雨：Schönbrunn 室內比重增加，Budapest 晚上減少戶外行程。"
    ],
    "11": [
      "晚間小雪：Buda Castle＋Rudas＋夜景。",
      "大雨：Central Market Hall／咖啡館＋Rudas；Buda 戶外縮短。",
      "晚風／濃霧：夜景遊船可取消或挪動，依訂票政策處理。"
    ],
    "12": [
      "一部天氣：河岸改室內及補給。",
      "Budapest 大雨／強風：減少河岸步行；夜車資訊優先。",
      "夜車異常：先確認營運資訊與替代交通；不自行改動原計畫。"
    ],
    "13": [
      "夜車準點＋天氣穩定：城堡 → Malá Strana → Charles Bridge。",
      "夜車晚到：縮短至老城小區散步；遊船取消。",
      "大雨／結冰：改室內咖啡館、博物館與休息。"
    ],
    "14": [
      "一切天氣：以準時抵達機場為首要目標。",
      "積雪／道路延誤：提早交通安排，避免緊迫轉乘。"
    ]
  },
